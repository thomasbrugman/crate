{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "~/lib/utils": ["./src/classNames.ts"],
      "gt-react": ["./src/translations.ts"],
      "~/*": ["../web/src/*"]
    }
  },
  "include": ["src", "remotion.config.ts"]
}
